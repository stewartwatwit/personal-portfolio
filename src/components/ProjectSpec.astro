---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<dl class="spec mono">
  <div>
    <dt>Status</dt>
    <dd>{project.status}</dd>
  </div>
  {project.statusNote && (
    <div>
      <dt>Note</dt>
      <dd>{project.statusNote}</dd>
    </div>
  )}
  {project.repoUrl && (
    <div>
      <dt>Repository</dt>
      <dd>
        <a href={project.repoUrl} target="_blank" rel="noopener">
          View on GitHub
        </a>
      </dd>
    </div>
  )}
</dl>

<style>
  .spec {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .spec div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: var(--space-3);
    padding-block: var(--space-2);
    border-top: 1px solid var(--rule);
  }

  dt {
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  dd {
    margin: 0;
  }
</style>
