---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container row mono">
    <p>© {year} William Stewart</p>
    <p class="balls" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
      <span class="four"></span>
      <span></span>
      <span></span>
      <span></span>
    </p>
    <p title="Dragon Radar not included." data-footer-note>
      Built with Astro
    </p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--space-6);
    border-top: 1px solid var(--rule);
    padding-block: var(--space-4);
    color: var(--ink-muted);
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2);
  }

  /* Seven barely-there dots. Hovering the fourth reveals its star. */
  .balls {
    display: flex;
    gap: 6px;
  }

  .balls span {
    position: relative;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--rule);
  }

  .balls .four::after {
    content: '★';
    position: absolute;
    inset: -4px;
    display: grid;
    place-items: center;
    font-size: 8px;
    line-height: 1;
    color: var(--accent);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .balls .four:hover::after {
    opacity: 1;
  }
</style>
