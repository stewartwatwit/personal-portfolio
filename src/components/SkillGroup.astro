---
interface Props {
  category: string;
  items: string[];
}

const { category, items } = Astro.props;
---

<div class="group">
  <h3 class="mono">{category}</h3>
  <ul class="mono">
    {items.map((i) => (
      <li>{i}</li>
    ))}
  </ul>
</div>

<style>
  .group {
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
  }

  h3 {
    margin-bottom: var(--space-3);
    color: var(--ink-muted);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li {
    padding: 0.25rem 0.625rem;
    border: 1px solid var(--rule);
    background: var(--surface);
  }
</style>
