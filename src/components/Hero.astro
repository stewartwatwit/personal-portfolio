---
import { profile, education } from '../data/profile';
---

<section class="hero container" aria-labelledby="hero-title">
  <p class="mono eyebrow">{profile.title}</p>
  <h1 id="hero-title">{profile.name}</h1>
  <p class="tagline">{profile.tagline}</p>
  <div class="actions">
    <a class="btn primary" href="#projects">
      View projects
    </a>
    <a class="btn" href="#contact">
      Contact
    </a>
    <a
      class="link mono"
      href={profile.resume.href}
      target="_blank"
      rel="noopener"
    >
      Résumé ({profile.resume.label})
    </a>
  </div>
  <dl class="facts mono">
    <div>
      <dt class="visually-hidden">Location</dt>
      <dd>{profile.location}</dd>
    </div>
    <div>
      <dt class="visually-hidden">Education</dt>
      <dd>
        B.S. Computer Science, {education.school}, {education.date}
      </dd>
    </div>
  </dl>
</section>

<style>
  .hero {
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .eyebrow {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  h1 {
    font-size: clamp(2.5rem, 11vw, 7rem);
    letter-spacing: -0.04em;
  }

  .tagline {
    max-width: 30ch;
    font-size: clamp(1.25rem, 3vw, 1.75rem);
    line-height: 1.3;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
  }

  .btn {
    display: inline-block;
    padding: 0.7rem 1.25rem;
    border: 1px solid var(--ink);
    text-decoration: none;
    font-weight: 600;
    transition:
      background 0.15s,
      color 0.15s,
      border-color 0.15s;
  }

  .btn:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .btn.primary {
    background: var(--ink);
    color: var(--bg);
  }

  .btn.primary:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--accent-ink);
  }

  .link {
    color: var(--ink-muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    color: var(--ink-muted);
  }

  .facts dd {
    margin: 0;
  }
</style>
