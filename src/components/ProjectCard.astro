---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const shownStack = project.featured ? project.stack.slice(0, 8) : project.stack;
const hidden = project.stack.length - shownStack.length;
---

<article class:list={['card', { featured: project.featured }]}>
  <p class="mono status">{project.status}</p>
  <h3>
    <a href={`/projects/${project.slug}`}>{project.name}</a>
  </h3>
  <p class="summary">{project.summary}</p>
  <ul class="stack mono" aria-label="Technologies">
    {shownStack.map((t) => (
      <li>{t}</li>
    ))}
    {hidden > 0 && <li class="more">+{hidden} more</li>}
  </ul>
  <a class="more-link mono" href={`/projects/${project.slug}`}>
    Read case study<span class="visually-hidden">: {project.name}</span> →
  </a>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--rule);
    transition:
      border-color 0.15s,
      transform 0.15s;
  }

  .card:hover,
  .card:focus-within {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .status {
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  h3 {
    font-size: 1.5rem;
  }

  .featured h3 {
    font-size: 1.875rem;
  }

  h3 a {
    text-decoration: none;
  }

  /* Whole card is clickable via the heading link */
  h3 a::before {
    content: '';
    position: absolute;
    inset: 0;
  }

  .summary {
    color: var(--ink-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: auto 0 0;
    padding: 0;
  }

  .stack li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
  }

  .stack .more {
    border-style: dashed;
    color: var(--ink-muted);
  }

  .more-link {
    text-decoration: none;
    color: var(--accent);
  }
</style>
