---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchDiagram from '../../components/ArchDiagram.astro';
import ProjectSpec from '../../components/ProjectSpec.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout
  title={`${project.name} | William Stewart`}
  description={project.summary}
>
  <article class="container page">
    <a class="back mono" href="/#projects">
      ← All projects
    </a>
    <h1>{project.name}</h1>
    <p class="lead">{project.summary}</p>

    <div class="layout">
      <aside>
        <ProjectSpec project={project} />
        <h2 class="mono label">Stack</h2>
        <ul class="stack mono">
          {project.stack.map((t) => (
            <li>{t}</li>
          ))}
        </ul>
      </aside>

      <div class="body">
        <section>
          <h2>Problem</h2>
          <p>{project.problem}</p>
        </section>
        <section>
          <h2>Solution</h2>
          <p>{project.solution}</p>
        </section>
        <section>
          <h2>Key technical details</h2>
          <ul>
            {project.keyDetails.map((d) => (
              <li>{d}</li>
            ))}
          </ul>
        </section>
        <ArchDiagram {...project.diagram} />
        {project.outcome && (
          <section>
            <h2>Outcome</h2>
            <p>{project.outcome}</p>
          </section>
        )}
        {project.caveat && (
          <section>
            <h2>Pilot results</h2>
            <p>{project.caveat}</p>
          </section>
        )}
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .page {
    padding-top: var(--space-5);
    display: grid;
    gap: var(--space-4);
  }

  .back {
    color: var(--ink-muted);
    text-decoration: none;
  }

  h1 {
    font-size: clamp(2.25rem, 7vw, 4.5rem);
    letter-spacing: -0.03em;
  }

  .lead {
    max-width: var(--measure);
    font-size: 1.25rem;
    color: var(--ink-muted);
  }

  .layout {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-4);
  }

  aside {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .label {
    margin: var(--space-3) 0 0;
    font-weight: 500;
    color: var(--ink-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .stack li {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--rule);
  }

  .body {
    display: grid;
    gap: var(--space-5);
    max-width: var(--measure);
  }

  .body :global(figure) {
    max-width: none;
  }

  section h2 {
    font-size: 1.5rem;
    margin-bottom: var(--space-3);
  }

  section ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  section li + li {
    margin-top: var(--space-2);
  }

  @media (min-width: 56rem) {
    .layout {
      grid-template-columns: 18rem 1fr;
      gap: var(--space-6);
    }

    aside {
      position: sticky;
      top: 6rem;
    }
  }
</style>
